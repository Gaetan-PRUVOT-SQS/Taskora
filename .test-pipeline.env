# Settings for scripts/test-pipeline.sh. Plain KEY=value lines, read as data and never executed.
# Unknown and duplicate keys are refused. COVERAGE_MIN (floor 80) can only be raised, FLAKY_RERUNS stays 0
# (no rerun). On a pull request the CI reads every key from the base branch copy of this file.
# The PostgreSQL test database is handled by the script itself: TEST_DATABASE_URL from the CI workflow,
# or scripts/test-db.sh locally, then test/scripts/check-test-db.mjs before the first stage.

LINT_CMD="npm run lint"
# unit: backend node:test + frontend Vitest component tests
UNIT_CMD="npm run test:unit"
# functional: API tests on Postgres + UI tests with Testing Library + Cypress E2E
FUNCTIONAL_CMD="npm run test:functional && npm run test:e2e"
# regression: everything again with coverage, plus the Cypress run and the Playwright DnD check
REGRESSION_CMD="npm run test:regression"

COVERAGE_MIN=80
FLAKY_RERUNS=0

# Paths whose change is structural for pipeline-config-guard (the stage runners read and write the reports)
PIPELINE_TRUSTED_PATHS="test/scripts/*"
