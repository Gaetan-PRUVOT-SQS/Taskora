# Settings for scripts/test-pipeline.sh (sourced by bash)

# Real PostgreSQL for the API, functional and E2E tests. In CI the workflow
# provides TEST_DATABASE_URL through a service container, locally we start one.
# In CI nothing is started here: a missing variable means the workflow is wrong.
SERVICES_UP_CMD='if [[ -z "${TEST_DATABASE_URL:-}" ]]; then if [[ "${CI:-}" == true ]]; then echo "TEST_DATABASE_URL must come from the CI workflow (postgres service)" >&2; false; else TEST_DATABASE_URL="$(scripts/test-db.sh start)" && export TEST_DATABASE_URL && STARTED_TEST_DB=1; fi; fi'
SERVICES_DOWN_CMD='if [[ "${STARTED_TEST_DB:-0}" == 1 && "${KEEP_TEST_DB:-0}" != 1 ]]; then scripts/test-db.sh stop; fi'
# no stage runs without a reachable Postgres
REQUIRED_ENV="TEST_DATABASE_URL"
SERVICES_CHECK_CMD="node test/scripts/check-test-db.mjs"

LINT_CMD="npm run lint"
# unit: backend node:test + frontend Vitest component tests
UNIT_CMD="npm run test:unit"
# functional: API tests on Postgres + UI tests with Testing Library + Cypress E2E
FUNCTIONAL_CMD="npm run test:functional && npm run test:e2e"
# regression: everything again (with coverage), plus non functional and the Playwright DnD check
REGRESSION_CMD="npm run test:regression"

COVERAGE_MIN=80
FLAKY_RERUNS=2
ALLOW_FLAKY=0
BASE_REF="${BASE_REF:-origin/main}"
