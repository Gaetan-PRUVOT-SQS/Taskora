{
  "name": "taskora",
  "private": true,
  "version": "1.0.0",
  "description": "Taskora: open source self-hosted kanban (SigmaQuantSystems)",
  "author": "SigmaQuantSystems / Gaetan-PRUVOT-SQS",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaetan-PRUVOT-SQS/Taskora.git"
  },
  "homepage": "https://github.com/Gaetan-PRUVOT-SQS/Taskora",
  "bugs": {
    "url": "https://github.com/Gaetan-PRUVOT-SQS/Taskora/issues"
  },
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "test/e2e"
  ],
  "scripts": {
    "postinstall": "ln -sfn ../backend/node_modules test/node_modules",
    "dev:backend": "npm run dev --workspace=taskora-backend",
    "dev:frontend": "npm run dev --workspace=taskora-frontend",
    "build": "npm run build --workspace=taskora-frontend",
    "test": "node test/scripts/run-unit.mjs && node test/scripts/run-functional.mjs && node test/scripts/run-non-functional.mjs",
    "test:unit": "node test/scripts/run-unit.mjs",
    "test:functional": "node test/scripts/run-functional.mjs",
    "test:non-functional": "node test/scripts/run-non-functional.mjs",
    "test:residual": "node test/scripts/run-residual.mjs",
    "test:e2e:dnd": "node test/scripts/run-e2e-dnd.mjs",
    "test:all": "node test/scripts/run-all.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=taskora-frontend",
    "test:e2e": "node test/scripts/run-e2e-cypress.mjs",
    "test:coverage": "node test/scripts/run-coverage.mjs",
    "test:regression": "node test/scripts/run-coverage.mjs && node test/scripts/run-e2e-cypress.mjs && node test/scripts/run-e2e-dnd.mjs",
    "test:pipeline": "bash scripts/test-pipeline.sh",
    "test:migrations": "node --test test/functional/backend/migrations-pg.test.js test/functional/backend/card-move-race.test.js",
    "test:perf": "bash scripts/perf/run-k6.sh smoke",
    "test:perf:load": "bash scripts/perf/run-k6.sh load",
    "test:mutation": "npm run test:mutation:backend && npm run test:mutation:frontend",
    "test:mutation:backend": "stryker run stryker.backend.config.mjs",
    "test:mutation:frontend": "stryker run stryker.frontend.config.mjs",
    "quality:traceability": "node scripts/quality/check-traceability.mjs",
    "quality:coverage": "node scripts/quality/check-coverage.mjs",
    "quality:mutation": "node scripts/quality/check-mutation.mjs",
    "quality:justifications": "node scripts/quality/check-justifications.mjs",
    "quality:gates": "node scripts/quality/check-traceability.mjs --check && node scripts/quality/check-justifications.mjs && node scripts/quality/check-coverage.mjs",
    "metrics:record": "node scripts/quality/record-metrics.mjs",
    "metrics:report": "node scripts/quality/metrics-report.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.1.1",
    "c8": "^12.0.0",
    "cypress": "^16.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.2"
    },
    "test-exclude": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
