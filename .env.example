# Copy to backend/.env or export in your shell.
# Never commit real secrets.

# Auth
JWT_SECRET=change-me-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://taskora:taskora@127.0.0.1:5432/taskora
# Dev without Postgres server:
# DB_DRIVER=pglite

# Server
PORT=3001
CORS_ORIGIN=*
UPLOAD_DIR=./data/uploads
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# Optional — GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:3001
