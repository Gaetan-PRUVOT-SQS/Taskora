# Copy to .env (docker compose reads it) or export the values in your shell.
# Never commit real secrets.

# Auth (required)
# The server refuses to start if JWT_SECRET is missing, short or a known example.
# Use at least 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# or: openssl rand -base64 48
JWT_SECRET=

# Database (PostgreSQL)
DATABASE_URL=postgresql://taskora:taskora@127.0.0.1:5432/taskora
# Dev without Postgres server:
# DB_DRIVER=pglite

# Server
PORT=3001
CORS_ORIGIN=*
UPLOAD_DIR=./data/uploads
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
# Calls to /api/backup per 15 minutes and per address (admin only route)
BACKUP_RATE_LIMIT_MAX=5
# Set to false to close public sign up
# REGISTRATION_OPEN=false
# Public address of the instance (with the bundled nginx, the site address).
# Gives the OAuth redirect_uri and is trusted by the origin check. The Host
# header sent by clients is never used. Required, in https, when
# NODE_ENV=production (the Docker image sets it). Outside production the
# default is http://localhost:3001. Example: https://taskora.example.com
BACKEND_URL=
# Front end address, BACKEND_URL by default in production,
# http://localhost:5173 otherwise
# FRONTEND_URL=https://taskora.example.com
# Other origins allowed to send requests that change data with the session
# cookie (comma separated, exact scheme, host and port). Needed only when the
# front end is served from another origin. Session cookies are Secure: use HTTPS.
# TRUSTED_ORIGINS=https://admin.taskora.example.com
# How often an open WebSocket re-checks its session, in ms
# WS_RECHECK_MS=60000

# Optional — GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
